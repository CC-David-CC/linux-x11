#!/bin/sh
echo 'X11 guest init'
export PATH=/bin:/sbin:/usr/bin
export LD_LIBRARY_PATH=/lib/i386-linux-gnu:/usr/lib/i386-linux-gnu
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /var/log /var/lib/xkb /run /tmp/.X11-unix
chmod 1777 /tmp /tmp/.X11-unix
mount -t devpts devpts /dev/pts -o mode=620,ptmxmode=666
ifconfig lo 127.0.0.1 up
printf "127.0.0.1 localhost\n" > /etc/hosts
for list in /modules/load-order /x11/modules/load-order; do
    while read -r module; do insmod "${list%/*}/$module"; done < "$list"
done
case " $(cat /proc/cmdline) " in
    *' guest_net=1 '*)
        if ifconfig eth0 10.86.0.2 netmask 255.255.255.0 up && route add default gw 10.86.0.1; then
            printf 'nameserver 10.86.0.3\n' > /etc/resolv.conf
        else
            echo 'Guest network interface failed to configure.'
        fi
        ;;
esac
echo 'X11 mounting home'
if ! mount -t 9p -o trans=virtio,version=9p2000.L,cache=none host9p /home/guest; then
    echo 'X11 home mount failed'
    exit 1
fi
chown 1000:1000 /home/guest
if grep -Eq '(^| )webos_chromium=1( |$)' /proc/cmdline; then
    echo 'X11 mounting Chromium disk'
    mkdir -p /opt/browser /usr/lib/chromium /dev/shm
    for attempt in $(seq 1 20); do
        [ -b /dev/sda ] && break
        sleep 0.5
    done
    if mount -t squashfs -o ro /dev/sda /opt/browser &&
       mount --bind /opt/browser/usr/lib/chromium /usr/lib/chromium &&
       mount -t tmpfs -o mode=1777,size=96m tmpfs /dev/shm; then
        echo 'Chromium disk ready'
    else
        echo 'Chromium disk could not mount'
    fi
fi
case " $(cat /proc/cmdline) " in
    *' webos_x11_large=1 '*) sed 's/Modes "800x600"/Modes "1280x800" "1360x768" "1024x768" "800x600"/' /x11/xorg.conf > /tmp/xorg.conf ;;
    *) cp /x11/xorg.conf /tmp/xorg.conf ;;
esac
for input in /sys/class/input/event*; do
    case "$(cat "$input/device/name")" in
        *keyboard*) role=CoreKeyboard;;
        *Mouse*|*mouse*)
            # v86 exposes both relative and absolute nodes with the same name.
            [ "$(cat "$input/device/capabilities/abs")" != 0 ] || continue
            role=CorePointer;;
        *) continue;;
    esac
    cat >> /tmp/xorg.conf <<EOF
Section "InputDevice"
    Identifier "$role"
    Driver "evdev"
    Option "Device" "/dev/input/${input##*/}"
    Option "$role" "true"
EndSection
EOF
done
export DISPLAY=:0 XAUTHORITY=/run/x11-authority
touch "$XAUTHORITY"
chmod 600 "$XAUTHORITY"
cookie=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
xauth -f "$XAUTHORITY" add :0 . "$cookie" || exit 1
chown 1000:1000 "$XAUTHORITY"
mkfontdir /usr/share/fonts/X11/misc
echo 'X11 starting Xorg'
/usr/lib/xorg/Xorg :0 vt1 -nolisten tcp -auth "$XAUTHORITY" -config /tmp/xorg.conf -logfile /var/log/Xorg.0.log -extension GLX &
xpid=$!
for n in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    kill -0 "$xpid" 2>/dev/null || break
    sleep 0.2
done
if [ -S /tmp/.X11-unix/X0 ]; then
    echo 'X11 starting clients'
    cd /home/guest || exit 1
    # The graphical clients and the interactive shell run as the guest user.
    export HOME=/home/guest USER=guest LOGNAME=guest SHELL=/bin/sh XDG_CACHE_HOME=/tmp/guest-cache
    mkdir -m 700 "$XDG_CACHE_HOME"
    chown 1000:1000 "$XDG_CACHE_HOME"
    python3 /x11/drop-privileges.py &
    clients_ready=false
    for n in $(seq 1 60); do
        if tree=$(xwininfo -root -tree) && echo "$tree" | grep -q '"xclock"' && echo "$tree" | grep -q '"xterm"'; then
            case " $(cat /proc/cmdline) " in
                *' x11_debug=1 '*) cat /proc/bus/input/devices /var/log/Xorg.0.log ;;
            esac
            echo 'X11 session ready'
            clients_ready=true
            break
        fi
        kill -0 "$xpid" 2>/dev/null || break
        sleep 0.5
    done
    if [ "$clients_ready" = false ]; then echo 'X11 clients did not become ready'; fi
else
    echo 'X11 display did not become ready'
fi
wait "$xpid"
cat /var/log/Xorg.0.log
while :; do sleep 3600; done
